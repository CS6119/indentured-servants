{
  "name": "raffleye",
  "version": "0.2.0",
  "private": true,
  "description": "Quiet, evidence-based Wuthering Waves giveaway discovery for Discord",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json && eslint app tests-ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js bot",
    "demo": "node dist/cli.js demo",
    "health": "node dist/cli.js health",
    "status": "node dist/cli.js status",
    "validate": "npm run check && npm test && npm run build",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/deploy.ps1",
    "deploy:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/watch-commits.ps1"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "better-sqlite3": "13.0.3",
    "city-timezones": "1.3.4",
    "discord.js": "14.27.0",
    "dotenv": "17.2.3",
    "playwright": "1.64.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.0",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.1.11"
  }
}
