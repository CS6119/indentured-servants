# All values are placeholders. Default mode performs no network requests.
RAFFLEYE_SOURCE=mock
RAFFLEYE_EXTRACTOR=rules
# gacha requires giveaway plus a prize amount, quantity, or winner count.
RAFFLEYE_GIVEAWAY_TOPIC=gacha
RAFFLEYE_PROFILE_WATCH_LIMIT=5
RAFFLEYE_NOTIFICATION_INTERVAL_SECONDS=300
# Render a cropped official public X embed with no account cookies/login.
RAFFLEYE_POST_SCREENSHOTS=true
# Windows: msedge or chrome; empty uses Playwright Chromium (install it first).
RAFFLEYE_SCREENSHOT_BROWSER_CHANNEL=
RAFFLEYE_DB_PATH=data/raffleye.sqlite3

# Official X API: enable SOURCE=x after configuring access and a cost reserve.
RAFFLEYE_X_BEARER_TOKEN=
RAFFLEYE_GLOBAL_QUERY="(giveaway OR giveaways) -is:retweet -is:reply"
RAFFLEYE_PAGE_SIZE=25
RAFFLEYE_LOOKBACK_HOURS=24
# First scan and periodic catch-up, bounded by the same request/cost budgets.
RAFFLEYE_X_SEARCH_MODE=recent
RAFFLEYE_BACKFILL_HOURS=144
RAFFLEYE_BACKFILL_INTERVAL_HOURS=24
# For older posts still running: X_SEARCH_MODE=all and BACKFILL_HOURS=720 (30 days),
# only with full-archive access and an appropriate budget.
RAFFLEYE_POLL_SECONDS=60
RAFFLEYE_GLOBAL_INTERVAL_SECONDS=900
RAFFLEYE_QUERIES_PER_TICK=4

# Apify reads an EXISTING authorized dataset. No actor is launched.
RAFFLEYE_APIFY_FALLBACK=false
RAFFLEYE_APIFY_AUTHORIZED=false
RAFFLEYE_APIFY_TOKEN=
RAFFLEYE_APIFY_DATASET_ID=

# Optional structured extraction through the OpenAI Responses API.
RAFFLEYE_OPENAI_API_KEY=
RAFFLEYE_OPENAI_MODEL=
RAFFLEYE_AI_MAX_OUTPUT_TOKENS=2500
RAFFLEYE_MAX_POST_CHARS=12000
RAFFLEYE_EXTRACTION_BATCH=25

# Single-server installation. IDs are numbers; token is a Discord BOT token.
RAFFLEYE_DISCORD_TOKEN=
RAFFLEYE_DISCORD_GUILD_ID=0
RAFFLEYE_ENDING_SOON_MINUTES=60

# Request/post caps are local hard caps. USD counters are ESTIMATES, not invoices.
RAFFLEYE_DAILY_X_REQUESTS=100
RAFFLEYE_DAILY_X_POSTS=2500
RAFFLEYE_DAILY_APIFY_REQUESTS=50
RAFFLEYE_DAILY_AI_REQUESTS=100
RAFFLEYE_DAILY_ESTIMATED_USD=2
RAFFLEYE_MONTHLY_ESTIMATED_USD=20
# Required positive operator estimates for each enabled live provider.
# Set conservative per-request maxima based on your plan, page size, token limits.
# Zero means live configuration is incomplete; it does NOT mean free API access.
RAFFLEYE_X_REQUEST_RESERVE_USD=0
RAFFLEYE_APIFY_REQUEST_RESERVE_USD=0
RAFFLEYE_AI_REQUEST_RESERVE_USD=0
